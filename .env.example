NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="replace-with-service-account-private-key"

SESSION_COOKIE_NAME=human-dialer-session
SESSION_COOKIE_MAX_AGE=432000
ENCRYPTION_KEY=base64-encoded-32-byte-key
# Telnyx API keys are stored per organization using AES-256-GCM.
# Required in production: Account webhook-signing public key from Telnyx Mission Control
# (Account Settings -> Keys & Credentials -> Public Key). Copy the Base64 value only.
# Do not use your Telnyx API key, API secret, phone number, or private key here.
TELNYX_PUBLIC_KEY=replace-with-base64-ed25519-public-key
# Public HTTPS origin used for Telnyx callbacks, e.g. https://your-app.onrender.com
NEXT_PUBLIC_APP_URL=
